{
  "additionalProperties": false,
  "properties": {
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Target Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "aliases": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Aliases",
      "type": "array"
    },
    "ambiguous_aliases": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Ambiguous Aliases",
      "type": "array"
    },
    "domains": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Domains",
      "type": "array"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 10000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "target_id",
    "name",
    "aliases",
    "domains"
  ],
  "title": "Target",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geo-audit:step5:Target:1.0"
}
