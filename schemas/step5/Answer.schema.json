{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "origin": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "url",
        "origin"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Answer Id",
      "type": "string"
    },
    "prompt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_set_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Prompt Set Id",
      "type": "string"
    },
    "group": {
      "anyOf": [
        {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group"
    },
    "provider": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "origin": {
      "enum": [
        "synthetic",
        "manual_chat",
        "api"
      ],
      "title": "Origin",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "repeat_index": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Repeat Index",
      "type": "integer"
    },
    "collection_eligible": {
      "default": true,
      "title": "Collection Eligible",
      "type": "boolean"
    },
    "collected_at": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collected At"
    },
    "search_mode": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Search Mode",
      "type": "string"
    },
    "country": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "language": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "settings": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxProperties": 100,
      "title": "Settings",
      "type": "object"
    },
    "status": {
      "enum": [
        "ok",
        "empty",
        "error",
        "truncated"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "maxLength": 500000,
      "title": "Text",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "maxItems": 200,
      "title": "Sources",
      "type": "array"
    },
    "raw_ref": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Ref"
    },
    "text_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Sha256"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "answer_id",
    "prompt_id",
    "prompt_set_id",
    "provider",
    "model",
    "origin",
    "repeat_index",
    "search_mode",
    "status",
    "text"
  ],
  "title": "Answer",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geo-audit:step5:Answer:1.0"
}
