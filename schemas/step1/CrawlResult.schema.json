{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/DiscoverySource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "role": {
          "enum": [
            "entry",
            "about",
            "services",
            "prices",
            "contacts",
            "faq",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "role_basis": {
          "title": "Role Basis",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Language"
        },
        "priority": {
          "maximum": 6,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "queued",
            "fetched",
            "failed",
            "skipped_robots",
            "skipped_policy_unknown",
            "skipped_scope",
            "skipped_external",
            "skipped_excluded",
            "skipped_parameter_limit",
            "duplicate",
            "not_attempted_budget",
            "cancelled",
            "not_selected_limit"
          ],
          "title": "State",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "alias_of": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alias Of"
        }
      },
      "required": [
        "candidate_id",
        "url",
        "sources",
        "role",
        "role_basis",
        "language",
        "priority",
        "ordinal",
        "selected",
        "state",
        "reason_code",
        "alias_of"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "discovered_urls": {
          "minimum": 0,
          "title": "Discovered Urls",
          "type": "integer"
        },
        "selected_candidates": {
          "minimum": 0,
          "title": "Selected Candidates",
          "type": "integer"
        },
        "fetch_successes": {
          "minimum": 0,
          "title": "Fetch Successes",
          "type": "integer"
        },
        "unique_html_pages": {
          "minimum": 0,
          "title": "Unique Html Pages",
          "type": "integer"
        },
        "extracted_pages": {
          "minimum": 0,
          "title": "Extracted Pages",
          "type": "integer"
        },
        "useful_pages": {
          "minimum": 0,
          "title": "Useful Pages",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "discarded_entries": {
          "minimum": 0,
          "title": "Discarded Entries",
          "type": "integer"
        },
        "skip_examples": {
          "items": {
            "type": "string"
          },
          "title": "Skip Examples",
          "type": "array"
        },
        "skip_examples_truncated": {
          "title": "Skip Examples Truncated",
          "type": "boolean"
        },
        "sitemap_truncated": {
          "title": "Sitemap Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "discovered_urls",
        "selected_candidates",
        "fetch_successes",
        "unique_html_pages",
        "extracted_pages",
        "useful_pages",
        "skipped",
        "failed",
        "discarded_entries",
        "skip_examples",
        "skip_examples_truncated",
        "sitemap_truncated"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DirectiveObservation": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "http_header",
            "html_meta",
            "data_nosnippet",
            "canonical"
          ],
          "title": "Source",
          "type": "string"
        },
        "representation": {
          "enum": [
            "static",
            "rendered"
          ],
          "title": "Representation",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recipient"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "tokens": {
          "items": {
            "type": "string"
          },
          "title": "Tokens",
          "type": "array"
        }
      },
      "required": [
        "source",
        "representation",
        "evidence_id",
        "recipient",
        "raw",
        "tokens"
      ],
      "title": "DirectiveObservation",
      "type": "object"
    },
    "DiscoverySource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "entry",
            "html_link",
            "sitemap",
            "redirect",
            "robots_directive",
            "standard_path"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "occurrence": {
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_id",
        "occurrence"
      ],
      "title": "DiscoverySource",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "usable",
            "limited",
            "insufficient",
            "needs_description",
            "user_supported"
          ],
          "title": "State",
          "type": "string"
        },
        "can_start_step2": {
          "title": "Can Start Step2",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "useful_page_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Useful Page Ids",
          "type": "array"
        },
        "supporting_page_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Supporting Page Ids",
          "type": "array"
        },
        "user_materials": {
          "items": {
            "$ref": "#/$defs/UserMaterial"
          },
          "title": "User Materials",
          "type": "array"
        }
      },
      "required": [
        "state",
        "can_start_step2",
        "reason",
        "useful_page_ids",
        "supporting_page_ids",
        "user_materials"
      ],
      "title": "Material",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Page Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "effective_url": {
          "format": "uri",
          "pattern": "^https?://",
          "title": "Effective Url",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "headings": {
          "items": {
            "type": "string"
          },
          "title": "Headings",
          "type": "array"
        },
        "lists": {
          "items": {
            "type": "string"
          },
          "title": "Lists",
          "type": "array"
        },
        "tables": {
          "items": {
            "type": "string"
          },
          "title": "Tables",
          "type": "array"
        },
        "main_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternate_texts": {
          "items": {
            "$ref": "#/$defs/TextRef"
          },
          "title": "Alternate Texts",
          "type": "array"
        },
        "extraction_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extraction Method"
        },
        "extractor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extractor Version"
        },
        "extraction_reason": {
          "title": "Extraction Reason",
          "type": "string"
        },
        "content_state": {
          "enum": [
            "html",
            "js_candidate",
            "access_barrier",
            "suspicious_html",
            "empty",
            "non_html",
            "incomplete",
            "too_large",
            "soft_404",
            "service_content"
          ],
          "title": "Content State",
          "type": "string"
        },
        "useful_candidate": {
          "title": "Useful Candidate",
          "type": "boolean"
        },
        "supporting_page": {
          "title": "Supporting Page",
          "type": "boolean"
        },
        "business_relevance": {
          "enum": [
            "observed",
            "not_observed",
            "unknown"
          ],
          "title": "Business Relevance",
          "type": "string"
        },
        "business_quotes": {
          "items": {
            "$ref": "#/$defs/QuoteRef"
          },
          "title": "Business Quotes",
          "type": "array"
        },
        "directives": {
          "items": {
            "$ref": "#/$defs/DirectiveObservation"
          },
          "title": "Directives",
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "header_capture_complete": {
          "title": "Header Capture Complete",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "page_id",
        "candidate_id",
        "url",
        "effective_url",
        "evidence_id",
        "title",
        "headings",
        "lists",
        "tables",
        "main_text",
        "alternate_texts",
        "extraction_method",
        "extractor_version",
        "extraction_reason",
        "content_state",
        "useful_candidate",
        "supporting_page",
        "business_relevance",
        "business_quotes",
        "directives",
        "signals",
        "header_capture_complete",
        "limitations"
      ],
      "title": "Page",
      "type": "object"
    },
    "QuoteRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "text_hash",
        "start",
        "end",
        "text"
      ],
      "title": "QuoteRef",
      "type": "object"
    },
    "RobotsDecision": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Decision Id",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Observation Id",
          "type": "string"
        },
        "evaluated_url": {
          "format": "uri",
          "pattern": "^https?://",
          "title": "Evaluated Url",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "product_token": {
          "minLength": 1,
          "title": "Product Token",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allowed",
            "disallowed",
            "unknown"
          ],
          "title": "Decision",
          "type": "string"
        },
        "robots_evidence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Robots Evidence Id"
        },
        "matched_group_lines": {
          "items": {
            "type": "integer"
          },
          "title": "Matched Group Lines",
          "type": "array"
        },
        "decisive_rule_lines": {
          "items": {
            "type": "integer"
          },
          "title": "Decisive Rule Lines",
          "type": "array"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "crawl_delay": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Crawl Delay"
        }
      },
      "required": [
        "decision_id",
        "observation_id",
        "evaluated_url",
        "origin",
        "product_token",
        "decision",
        "robots_evidence_id",
        "matched_group_lines",
        "decisive_rule_lines",
        "reason_code",
        "parser_version",
        "crawl_delay"
      ],
      "title": "RobotsDecision",
      "type": "object"
    },
    "RobotsObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Observation Id",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        },
        "final_url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Url"
        },
        "state": {
          "enum": [
            "present",
            "empty",
            "absent",
            "access_denied",
            "rate_limited",
            "unreachable",
            "invalid_response",
            "incomplete"
          ],
          "title": "State",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Code"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "sitemap_urls": {
          "items": {
            "type": "string"
          },
          "title": "Sitemap Urls",
          "type": "array"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "origin",
        "final_url",
        "state",
        "evidence_ids",
        "status_code",
        "observed_at",
        "parser_version",
        "warnings",
        "sitemap_urls",
        "truncated"
      ],
      "title": "RobotsObservation",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "lang",
            "hreflang",
            "address",
            "service_geography",
            "tld",
            "phone"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "strength": {
          "enum": [
            "explicit",
            "weak"
          ],
          "title": "Strength",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "strength",
        "quote",
        "evidence_id"
      ],
      "title": "Signal",
      "type": "object"
    },
    "SitemapEntry": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "exclusiveMaximum": 5000,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "raw_loc": {
          "maxLength": 2048,
          "title": "Raw Loc",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "state": {
          "enum": [
            "accepted",
            "skipped"
          ],
          "title": "State",
          "type": "string"
        },
        "inferred_url": {
          "const": false,
          "default": false,
          "title": "Inferred Url",
          "type": "boolean"
        },
        "publisher_metadata": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Publisher Metadata",
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "ordinal",
        "raw_loc",
        "url",
        "state",
        "publisher_metadata",
        "issues"
      ],
      "title": "SitemapEntry",
      "type": "object"
    },
    "SitemapObservation": {
      "additionalProperties": false,
      "properties": {
        "sitemap_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Sitemap Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "depth": {
          "maximum": 3,
          "minimum": 1,
          "title": "Depth",
          "type": "integer"
        },
        "state": {
          "enum": [
            "parsed",
            "absent",
            "invalid",
            "incomplete",
            "skipped",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "urls": {
          "items": {
            "format": "uri",
            "pattern": "^https?://",
            "type": "string"
          },
          "title": "Urls",
          "type": "array"
        },
        "child_sitemaps": {
          "items": {
            "format": "uri",
            "pattern": "^https?://",
            "type": "string"
          },
          "title": "Child Sitemaps",
          "type": "array"
        },
        "publisher_metadata": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Publisher Metadata",
          "type": "array"
        },
        "parsed_entries": {
          "minimum": 0,
          "title": "Parsed Entries",
          "type": "integer"
        },
        "skipped_entries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Skipped Entries"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SitemapEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiscoverySource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "sitemap_id",
        "url",
        "depth",
        "state",
        "evidence_ids",
        "urls",
        "child_sitemaps",
        "publisher_metadata",
        "parsed_entries",
        "skipped_entries",
        "reason_code",
        "truncated"
      ],
      "title": "SitemapObservation",
      "type": "object"
    },
    "TextRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "text_chars": {
          "minimum": 0,
          "title": "Text Chars",
          "type": "integer"
        },
        "normalization_version": {
          "const": "text-ws-1",
          "default": "text-ws-1",
          "title": "Normalization Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "text_hash",
        "text_chars"
      ],
      "title": "TextRef",
      "type": "object"
    },
    "UserMaterial": {
      "additionalProperties": false,
      "properties": {
        "material_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Material Id",
          "type": "string"
        },
        "source_type": {
          "const": "user_provided",
          "default": "user_provided",
          "title": "Source Type",
          "type": "string"
        },
        "author_type": {
          "const": "user",
          "default": "user",
          "title": "Author Type",
          "type": "string"
        },
        "provided_at": {
          "format": "date-time",
          "title": "Provided At",
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/TextRef"
        },
        "suitability": {
          "enum": [
            "usable",
            "needs_clarification",
            "unknown"
          ],
          "title": "Suitability",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "provided_at",
        "text",
        "suitability",
        "reason"
      ],
      "title": "UserMaterial",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "step1-1.0.0",
      "default": "step1-1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "algorithm_version": {
      "const": "step1-1.0",
      "default": "step1-1.0",
      "title": "Algorithm Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Run Id",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Publication Id",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "registry_version": {
      "minLength": 1,
      "title": "Registry Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "robots": {
      "items": {
        "$ref": "#/$defs/RobotsObservation"
      },
      "title": "Robots",
      "type": "array"
    },
    "robots_decisions": {
      "items": {
        "$ref": "#/$defs/RobotsDecision"
      },
      "title": "Robots Decisions",
      "type": "array"
    },
    "sitemaps": {
      "items": {
        "$ref": "#/$defs/SitemapObservation"
      },
      "title": "Sitemaps",
      "type": "array"
    },
    "pending_external_urls": {
      "items": {
        "format": "uri",
        "pattern": "^https?://",
        "type": "string"
      },
      "title": "Pending External Urls",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "material": {
      "$ref": "#/$defs/Material"
    }
  },
  "required": [
    "run_id",
    "publication_id",
    "config_hash",
    "registry_version",
    "started_at",
    "finished_at",
    "candidates",
    "pages",
    "robots",
    "robots_decisions",
    "sitemaps",
    "pending_external_urls",
    "coverage",
    "material"
  ],
  "title": "CrawlResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geo-audit:CrawlResult:1.0.0"
}
