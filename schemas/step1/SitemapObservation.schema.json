{
  "$defs": {
    "DiscoverySource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "entry",
            "html_link",
            "sitemap",
            "redirect",
            "robots_directive",
            "standard_path"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Source Id",
          "type": "string"
        },
        "occurrence": {
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_id",
        "occurrence"
      ],
      "title": "DiscoverySource",
      "type": "object"
    },
    "SitemapEntry": {
      "additionalProperties": false,
      "properties": {
        "ordinal": {
          "exclusiveMaximum": 5000,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "raw_loc": {
          "maxLength": 2048,
          "title": "Raw Loc",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "state": {
          "enum": [
            "accepted",
            "skipped"
          ],
          "title": "State",
          "type": "string"
        },
        "inferred_url": {
          "const": false,
          "default": false,
          "title": "Inferred Url",
          "type": "boolean"
        },
        "publisher_metadata": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Publisher Metadata",
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "ordinal",
        "raw_loc",
        "url",
        "state",
        "publisher_metadata",
        "issues"
      ],
      "title": "SitemapEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sitemap_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Sitemap Id",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "pattern": "^https?://",
      "title": "Url",
      "type": "string"
    },
    "depth": {
      "maximum": 3,
      "minimum": 1,
      "title": "Depth",
      "type": "integer"
    },
    "state": {
      "enum": [
        "parsed",
        "absent",
        "invalid",
        "incomplete",
        "skipped",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "urls": {
      "items": {
        "format": "uri",
        "pattern": "^https?://",
        "type": "string"
      },
      "title": "Urls",
      "type": "array"
    },
    "child_sitemaps": {
      "items": {
        "format": "uri",
        "pattern": "^https?://",
        "type": "string"
      },
      "title": "Child Sitemaps",
      "type": "array"
    },
    "publisher_metadata": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Publisher Metadata",
      "type": "array"
    },
    "parsed_entries": {
      "minimum": 0,
      "title": "Parsed Entries",
      "type": "integer"
    },
    "skipped_entries": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Skipped Entries"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason Code"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SitemapEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DiscoverySource"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sitemap_id",
    "url",
    "depth",
    "state",
    "evidence_ids",
    "urls",
    "child_sitemaps",
    "publisher_metadata",
    "parsed_entries",
    "skipped_entries",
    "reason_code",
    "truncated"
  ],
  "title": "SitemapObservation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geo-audit:SitemapObservation:1.0.0"
}
