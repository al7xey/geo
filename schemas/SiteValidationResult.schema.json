          "CONTENT_NON_HTML",
          "CONTENT_TOO_LARGE",
          "CONTENT_INCOMPLETE",
          "CONTENT_ENCODING_UNSUPPORTED",
          "CONTENT_DECODE_ERROR",
          "CONTENT_SUSPICIOUS",
          "CONTENT_JS_CANDIDATE",
          "ACCESS_LOGIN",
          "ACCESS_CHALLENGE",
          "BUDGET_DEADLINE",
