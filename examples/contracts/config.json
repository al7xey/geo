{
  "schema_version": "1.2.0",
  "config_version": "step0-config-1.2.0",
  "allow_http_fallback": true,
  "allowed_hosts": [],
  "allowed_extra_ports": [],
  "path_scope": [],
  "step0_deadline_seconds": 60.0,
  "total_deadline_seconds": 300.0,
  "step0_max_attempts": 15,
  "total_max_attempts": 150,
  "connect_timeout_seconds": 5.0,
  "read_timeout_seconds": 15.0,
  "write_timeout_seconds": 10.0,
  "pool_timeout_seconds": 5.0,
  "max_redirect_hops": 5,
  "max_retries": 2,
  "retry_delays_seconds": [
    1.0,
    2.0
  ],
  "retry_jitter_seconds": 0.2,
  "max_encoded_bytes": 5242880,
  "max_decoded_bytes": 5242880,
  "sniff_bytes": 4096,
  "min_host_interval_seconds": 1.0,
  "user_agent": "GEOAudit/0.1",
  "accept_language": "ru,en;q=0.8",
  "source_timezone": "Europe/Moscow",
  "tls_verify": true,
  "trust_env": false,
  "proxy_mode": "disabled",
  "cookie_mode": "disabled",
  "dns_policy": "public_only_pinned"
}
