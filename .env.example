# Скопируйте в private/.env (папка private/ не попадает в Git) и впишите свои ключи.
# Перед запуском:  set -a; source private/.env; set +a
# Нужны только ключи систем, которые вы запускаете (--systems в шаге 4).

# Шаг 2 (профиль и вопросы) и шаг 4 (Claude)
ANTHROPIC_API_KEY=
# Шаг 4: ChatGPT
OPENAI_API_KEY=
# Шаг 4: Gemini через Vertex AI (Google Cloud → APIs & Services → Credentials,
# ключ с ограничением на Agent Platform API)
VERTEX_API_KEY=
# Шаг 4: DeepSeek и Perplexity
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
